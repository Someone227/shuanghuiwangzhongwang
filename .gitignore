# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# 编辑器
.vscode/
.idea/

# Node
node_modules/
dist/
*.tsbuildinfo

# 静态部署数据（由 server/scripts/export-static-data.mjs 从 data/policies 生成）
web/public/policies/

# Python
__pycache__/
*.pyc

# 环境变量（.env.example 是模板，需要提交；真实 .env 禁止入库）
.env
.env.local
.env.*.local

# 运行数据：SQLite 数据库与上传缓存
# 注意：data/policies/ 是政策库数据资产（原文 + AI 抽取的条件树），必须入库
data/*.db
data/*.db-journal
data/uploads/
*.db
*.db-journal
*.sqlite
*.sqlite3

# 账号与个人数据（运行期生成，不入库；演示账号首次启动自动创建）
data/users.json
data/user-data.json
data/.auth-secret
data/*.tmp

# 日志
*.log
logs/
# 技术文档构建产物（由 docs/tech-report/build.mjs 生成，源文件是 part*.html）
docs/tech-report/report.html
