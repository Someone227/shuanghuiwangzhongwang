# ===== 服务 =====
PORT=8787

# ===== DeepSeek 大模型 =====
# 只有「重新抽取政策」时才需要 Key；日常使用（判定）全部在本地完成，不需要 Key。
# 在 https://platform.deepseek.com 申请，切勿提交到仓库
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-chat

# ===== 账号系统 =====
# 演示账号（demo）的密码，公开写在 README 里供老师查验；首次启动自动创建该账号。
# 想换密码：先删除 data/users.json 再改这里重启。
DEMO_ACCOUNT_PASSWORD=NengShenMa2026

# 登录令牌的签名密钥。留空则首次启动自动生成并写入 data/.auth-secret（不会入库）。
# 公网部署时建议显式设置一个足够长的随机串。
AUTH_SECRET=
